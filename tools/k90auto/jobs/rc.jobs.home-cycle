# Ported from iola1999/hackios-redmi-k90-annibale tools/k90auto/jobs/rc.jobs.home-cycle @00c4cce (warsaw fork, tranche 13, item 4).
# home-cycle: page swipes on the home screen for a fixed-length round.
#
# The lock screen is dismissed by libredwood-sb26.dylib inside SpringBoard; the notification below
# asks for that again in case the boot unlock gave up. init splits a line into at most 63 words, so
# each anntouch line stays well under that (the 2026-10-29 version had 200 and stopped at word 63
# with 'bad step "swipe"').
#
# init waits for each line, so every background line ends with & and goes before anntouch.
/redwood/bin/lsprobe 60 &
/redwood/bin/framewatch --every 20 --count 30 SpringBoard backboardd &
/redwood/bin/anntouch wait 40 notify com.redwood.unlock wait 5
/redwood/bin/anntouch swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4
/redwood/bin/anntouch swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4
/redwood/bin/anntouch swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4 swipe 0.85 0.55 0.15 0.55 250 wait 4 swipe 0.15 0.55 0.85 0.55 250 wait 4
